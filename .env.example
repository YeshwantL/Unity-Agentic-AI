# Optional: used only by online Gemini planning/diagnosis paths.
# The deterministic capability planner and offline workflow do not require it.
GEMINI_API_KEY=replace_with_your_own_key

# Absolute paths to the Unity project and Unity 6000.3.25f1 Editor executable.
UNITY_PROJECT_PATH=C:\path\to\Unity-Agentic-AI\UnityProject
UNITY_EDITOR_PATH=C:\Program Files\Unity\Hub\Editor\6000.3.25f1\Editor\Unity.exe

# Optional bounded recovery setting (default: 2).
MAX_REPAIR_ATTEMPTS=2
